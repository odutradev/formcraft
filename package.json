{
  "name": "multi-step-form",
  "version": "0.1.8",
  "description": "Config-driven multi-step form library for React with pluggable UI adapters",
  "keywords": [
    "react",
    "form",
    "multi-step",
    "wizard",
    "headless",
    "mui",
    "config-driven"
  ],
  "license": "MIT",
  "author": "odutradev",
  "homepage": "https://github.com/odutradev/multiStepForm#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/odutradev/multiStepForm.git"
  },
  "bugs": {
    "url": "https://github.com/odutradev/multiStepForm/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./mui": {
      "types": "./dist/lib/mui/index.d.ts",
      "import": "./dist/mui.js",
      "require": "./dist/mui.cjs"
    },
    "./native": {
      "types": "./dist/lib/native/index.d.ts",
      "import": "./dist/native.js",
      "require": "./dist/native.cjs"
    }
  },
  "scripts": {
    "dev": "vite --config playground/vite.config.ts",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "typecheck:playground": "tsc --noEmit -p playground",
    "lint": "eslint .",
    "format": "prettier --write .",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "@emotion/react": ">=11",
    "@emotion/styled": ">=11",
    "@mui/icons-material": ">=9",
    "@mui/material": ">=9",
    "@mui/x-date-pickers": ">=9",
    "dayjs": ">=1.11",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "peerDependenciesMeta": {
    "@mui/material": {
      "optional": true
    },
    "@mui/icons-material": {
      "optional": true
    },
    "@mui/x-date-pickers": {
      "optional": true
    },
    "@emotion/react": {
      "optional": true
    },
    "@emotion/styled": {
      "optional": true
    },
    "dayjs": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ant-design/icons": "^6.3.4",
    "@chakra-ui/react": "^3.38.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@eslint/js": "^9.39.5",
    "@mantine/core": "^9.8.2",
    "@mantine/dates": "^9.8.2",
    "@mantine/hooks": "^9.8.2",
    "@mui/icons-material": "^9.6.0",
    "@mui/material": "^9.6.0",
    "@mui/x-date-pickers": "^9.18.0",
    "@tabler/icons-react": "^3.53.0",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "antd": "^6.7.2",
    "dayjs": "^1.11.23",
    "enchase": "^0.27.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "lucide-react": "^1.81.0",
    "prettier": "^3.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.4.0",
    "vite-plugin-dts": "^5.1.2"
  }
}
