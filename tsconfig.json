{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client"],
    "paths": {
      "@components/*": ["./src/components/*"],
      "@adapters/*": ["./src/adapters/*"],
      "@hooks/*": ["./src/hooks/*"],
      "@core/*": ["./src/core/*"]
    }
  },
  "include": ["src", "lib"]
}
