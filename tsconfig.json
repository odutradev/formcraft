{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client"],
    "paths": {
      "@components": ["./src/components"],
      "@components/*": ["./src/components/*"],
      "@functions": ["./src/functions"],
      "@functions/*": ["./src/functions/*"],
      "@adapters": ["./src/adapters"],
      "@adapters/*": ["./src/adapters/*"],
      "@context": ["./src/context"],
      "@context/*": ["./src/context/*"],
      "@typings": ["./src/types"],
      "@typings/*": ["./src/types/*"],
      "@engine": ["./src/engine"],
      "@engine/*": ["./src/engine/*"],
      "@labels": ["./src/labels"],
      "@labels/*": ["./src/labels/*"],
      "@hooks": ["./src/hooks"],
      "@hooks/*": ["./src/hooks/*"]
    }
  },
  "include": ["src", "lib"]
}
